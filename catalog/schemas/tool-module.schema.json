{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forsvn.com/schemas/conquistador/tool-module-1.0.0.schema.json",
  "title": "Conquistador Tool Module contracts",
  "$ref": "#/$defs/Catalog",
  "type": "object",
  "$defs": {
    "Sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "SupportEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "providerVersion", "adapterVersion", "checkedAt", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["research", "fixture", "live", "release-matrix", "retirement"] },
        "candidateBuildId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "providerVersion": { "type": "string", "minLength": 1 },
        "adapterVersion": { "type": "string", "minLength": 1 },
        "checkedAt": { "type": "string", "format": "date-time" },
        "digest": { "$ref": "#/$defs/Sha256" },
        "terminalReceiptId": { "type": "string", "minLength": 1 },
        "humanAcceptanceId": { "type": "string", "minLength": 1 }
      }
    },
    "SupportCell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "platform", "architecture", "state", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 },
        "state": { "enum": ["unknown", "cataloged", "researched", "fixture-verified", "live-verified", "supported", "degraded", "retired"] },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/SupportEvidence" } }
      }
    },
    "OperationContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "capabilityId", "provider", "product", "category", "outcomes", "actionClass", "providerApiVersion", "authScopes", "dataClassification", "pii", "residency", "rateLimit", "quotaUnit", "monetaryUnit", "inputKeys", "requiredInputKeys", "outputKeys", "inputSchema", "outputSchema", "pagination", "retry", "idempotency", "officialSources", "provenance", "checkedAt", "knownGaps", "roadmapDestination", "supportCells"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "capabilityId": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "provider": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "product": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "outcomes": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "actionClass": { "enum": ["observe", "metered-observe", "draft", "consequential", "prohibited"] },
        "providerApiVersion": { "type": "string", "minLength": 1 },
        "authScopes": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "dataClassification": { "enum": ["public", "internal", "confidential", "restricted"] },
        "pii": { "enum": ["none", "possible", "required"] },
        "residency": { "type": "string", "minLength": 1 },
        "rateLimit": { "type": "string", "minLength": 1 },
        "quotaUnit": { "type": "string", "minLength": 1 },
        "monetaryUnit": { "type": "string", "minLength": 1 },
        "maximumUnitsPerRun": { "type": "number", "minimum": 0 },
        "maximumCostPerRun": { "type": "number", "minimum": 0 },
        "inputKeys": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "requiredInputKeys": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "outputKeys": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "inputSchema": { "$ref": "#/$defs/ObjectSchema" },
        "outputSchema": { "$ref": "#/$defs/ObjectSchema" },
        "pagination": { "type": "string", "minLength": 1 },
        "retry": { "type": "string", "minLength": 1 },
        "idempotency": { "enum": ["none", "required"] },
        "officialSources": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uri" } },
        "provenance": { "type": "string", "minLength": 1 },
        "checkedAt": { "type": "string", "format": "date-time" },
        "knownGaps": { "type": "array", "items": { "type": "string" } },
        "roadmapDestination": { "type": "string", "minLength": 1 },
        "supportCells": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/SupportCell" } }
      },
      "allOf": [
        {
          "if": { "properties": { "actionClass": { "enum": ["metered-observe", "draft", "consequential"] } } },
          "then": {
            "required": ["maximumUnitsPerRun", "maximumCostPerRun"],
            "properties": {
              "maximumUnitsPerRun": { "type": "number", "exclusiveMinimum": 0 },
              "maximumCostPerRun": { "type": "number", "minimum": 0 }
            }
          }
        },
        {
          "if": { "properties": { "actionClass": { "const": "consequential" } } },
          "then": { "properties": { "idempotency": { "const": "required" } } }
        }
      ]
    },
    "ValueSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["string", "number", "integer", "boolean", "array", "object"] },
        "items": { "$ref": "#/$defs/ValueSchema" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "array" } } },
          "then": { "required": ["items"] },
          "else": { "not": { "required": ["items"] } }
        }
      ]
    },
    "ObjectSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "additionalProperties", "properties", "required"],
      "properties": {
        "type": { "const": "object" },
        "additionalProperties": { "const": false },
        "properties": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/ValueSchema" }
        },
        "required": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "Catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "productVersion", "status", "operations"],
      "properties": {
        "schemaVersion": { "const": "conquistador.tool-catalog/v1" },
        "productVersion": { "const": "1.0.0" },
        "status": { "enum": ["candidate-operations-not-supported", "candidate-bound"] },
        "operations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/OperationContract" } }
      }
    },
    "CapabilityRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "candidateBuildId", "capabilityId", "operationId", "connectionRef", "expectedPrincipal", "connectionEnvironment", "connectionRevision", "input", "deadlineAt"],
      "properties": {
        "schemaVersion": { "const": "conquistador.capability-request/v1" },
        "id": { "type": "string", "minLength": 1 },
        "candidateBuildId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "capabilityId": { "type": "string", "minLength": 1 },
        "operationId": { "type": "string", "minLength": 1 },
        "connectionRef": { "type": "string", "minLength": 1 },
        "expectedPrincipal": { "$ref": "#/$defs/Principal" },
        "connectionEnvironment": { "enum": ["sandbox", "production"] },
        "connectionRevision": { "type": "integer", "minimum": 1 },
        "input": { "type": "object" },
        "deadlineAt": { "type": "string", "format": "date-time" },
        "idempotencyKey": { "type": "string", "minLength": 1 },
        "maxUnits": { "type": "number", "minimum": 0 },
        "maxCost": { "type": "number", "minimum": 0 }
      }
    },
    "CapabilityResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "requestId", "operationId", "data", "sourceUrls", "freshnessAt", "pagination", "unitsUsed", "costUsed", "providerStatus"],
      "properties": {
        "schemaVersion": { "const": "conquistador.capability-result/v1" },
        "requestId": { "type": "string" },
        "operationId": { "type": "string" },
        "providerRequestId": { "type": "string" },
        "providerCorrelationId": { "type": "string" },
        "providerResourceId": { "type": "string" },
        "data": { "type": "object" },
        "sourceUrls": { "type": "array", "items": { "type": "string", "format": "uri" } },
        "freshnessAt": { "type": "string", "format": "date-time" },
        "pagination": {
          "type": "object",
          "additionalProperties": false,
          "required": ["complete", "truncated"],
          "properties": {
            "complete": { "type": "boolean" },
            "cursor": { "type": "string" },
            "truncated": { "type": "boolean" }
          }
        },
        "unitsUsed": { "type": "number", "minimum": 0 },
        "costUsed": { "type": "number", "minimum": 0 },
        "providerStatus": { "enum": ["succeeded", "partial", "pending", "unknown"] }
      }
    },
    "CapabilityError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "requestId", "code", "message", "retryable"],
      "properties": {
        "schemaVersion": { "const": "conquistador.capability-error/v1" },
        "requestId": { "type": "string" },
        "code": { "enum": ["unknown-operation", "unsupported", "stale-support", "scope-denied", "principal-denied", "connection-denied", "budget-denied", "approval-denied", "replay-denied", "cancelled", "provider-failure", "prohibited", "invalid-request"] },
        "message": { "type": "string" },
        "retryable": { "type": "boolean" }
      }
    },
    "AdapterManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "provider", "version", "sdkVersion", "operationIds", "capabilityIds", "credentialInjection", "transport"],
      "properties": {
        "schemaVersion": { "const": "conquistador.adapter-manifest/v1" },
        "id": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
        "sdkVersion": { "const": "1.0.0" },
        "operationIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "capabilityIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "credentialInjection": { "const": "host-only" },
        "transport": { "const": "audited-adapter-only" }
      }
    },
    "ExtensionCatalogReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "capabilityId", "operationId"],
      "properties": {
        "provider": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "capabilityId": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "operationId": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" }
      }
    },
    "ExtensionBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rateLimit", "quotaUnit", "monetaryUnit"],
      "properties": {
        "rateLimit": { "type": "string", "minLength": 1 },
        "quotaUnit": { "type": "string", "minLength": 1 },
        "monetaryUnit": { "type": "string", "minLength": 1 },
        "maximumUnitsPerRun": { "type": "number", "exclusiveMinimum": 0 },
        "maximumCostPerRun": { "type": "number", "minimum": 0 }
      }
    },
    "ExtensionConnection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "provider", "scopes", "credentialCustody"],
      "properties": {
        "required": { "type": "boolean" },
        "provider": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "scopes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "not": { "pattern": "\\*" } } },
        "credentialCustody": { "const": "host-only" }
      }
    },
    "ExtensionFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unavailable", "degraded", "retry", "recovery"],
      "properties": {
        "unavailable": { "enum": ["fail-closed", "omit-optional-dependency"] },
        "degraded": { "enum": ["fail-closed", "return-degraded-result"] },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy", "maximumAttempts", "backoff"],
          "properties": {
            "strategy": { "enum": ["none", "bounded"] },
            "maximumAttempts": { "type": "integer", "minimum": 0, "maximum": 5 },
            "backoff": { "enum": ["none", "fixed", "exponential"] }
          },
          "allOf": [
            { "if": { "properties": { "strategy": { "const": "none" } } }, "then": { "properties": { "maximumAttempts": { "const": 0 }, "backoff": { "const": "none" } } } },
            { "if": { "properties": { "strategy": { "const": "bounded" } } }, "then": { "properties": { "maximumAttempts": { "minimum": 1 } } } }
          ]
        },
        "recovery": { "enum": ["manual-reconnect", "resume-from-artifact", "not-applicable"] }
      }
    },
    "ExtensionOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "capabilityId", "inputSchema", "outputSchema", "actionClass", "budget", "connection", "maturity", "dependencies", "failure"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "capabilityId": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "catalog": { "$ref": "#/$defs/ExtensionCatalogReference" },
        "inputSchema": { "$ref": "#/$defs/ObjectSchema" },
        "outputSchema": { "$ref": "#/$defs/ObjectSchema" },
        "actionClass": { "enum": ["observe", "metered-observe", "draft", "consequential", "prohibited"] },
        "budget": { "$ref": "#/$defs/ExtensionBudget" },
        "connection": { "$ref": "#/$defs/ExtensionConnection" },
        "maturity": { "enum": ["unknown", "cataloged", "researched", "fixture-verified", "live-verified", "supported"] },
        "dependencies": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/ExtensionCatalogReference" } },
        "failure": { "$ref": "#/$defs/ExtensionFailure" }
      },
      "allOf": [
        {
          "if": { "properties": { "actionClass": { "enum": ["metered-observe", "draft", "consequential"] } } },
          "then": { "properties": { "budget": { "required": ["maximumUnitsPerRun", "maximumCostPerRun"] } } }
        }
      ]
    },
    "ExtensionProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "sourceVersion", "digest"],
      "properties": {
        "sourceId": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "sourceVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
        "digest": { "$ref": "#/$defs/Sha256" }
      }
    },
    "ExtensionManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "version", "kind", "activation", "transport", "provenance", "operations"],
      "properties": {
        "schemaVersion": { "const": "conquistador.extension-manifest/v1" },
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
        "kind": { "enum": ["outcome-skill", "host-tool", "provider-adapter"] },
        "activation": { "enum": ["on-demand-skill", "host-mediated", "typed-adapter"] },
        "transport": { "enum": ["none", "host-connector", "host-mcp", "audited-adapter-only"] },
        "provenance": { "$ref": "#/$defs/ExtensionProvenance" },
        "operations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/ExtensionOperation" } }
      },
      "oneOf": [
        {
          "properties": {
            "kind": { "const": "outcome-skill" },
            "activation": { "const": "on-demand-skill" },
            "transport": { "const": "none" },
            "operations": {
              "items": {
                "allOf": [
                  { "$ref": "#/$defs/ExtensionOperation" },
                  { "properties": { "actionClass": { "const": "observe" } } }
                ]
              }
            }
          }
        },
        { "properties": { "kind": { "const": "host-tool" }, "activation": { "const": "host-mediated" }, "transport": { "enum": ["host-connector", "host-mcp"] } } },
        { "properties": { "kind": { "const": "provider-adapter" }, "activation": { "const": "typed-adapter" }, "transport": { "const": "audited-adapter-only" } } }
      ]
    },
    "Principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accountId", "workspaceId", "displayName"],
      "properties": {
        "accountId": { "type": "string", "minLength": 1, "pattern": "^(?!.*\\*).+$" },
        "workspaceId": { "type": "string", "minLength": 1, "pattern": "^(?!.*\\*).+$" },
        "displayName": { "type": "string", "minLength": 1, "pattern": "^(?!.*\\*).+$" }
      }
    },
    "ConnectionReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "provider", "principal", "allowedOperationIds", "scopes", "environment", "usage", "revision", "state", "verifiedAt", "storagePolicy"],
      "properties": {
        "schemaVersion": { "const": "conquistador.connection-reference/v1" },
        "id": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "provider": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "principal": { "$ref": "#/$defs/Principal" },
        "allowedOperationIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" } },
        "scopes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "pattern": "^(?!.*\\*).+$" } },
        "environment": { "enum": ["sandbox", "production"] },
        "usage": { "enum": ["ephemeral-test", "user-production"] },
        "revision": { "type": "integer", "minimum": 1 },
        "state": { "enum": ["active", "revoked", "expired"] },
        "rotatedFrom": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "verifiedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "invalidatedAt": { "type": "string", "format": "date-time" },
        "storagePolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["referenceMetadata", "secretStorage", "export", "recovery"],
          "properties": {
            "referenceMetadata": { "const": "conquistador-local" },
            "secretStorage": { "const": "host-secure-store-only" },
            "export": { "const": "forbidden" },
            "recovery": { "const": "reauthenticate-only" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "environment": { "const": "sandbox" } } },
          "then": { "properties": { "usage": { "const": "ephemeral-test" } } },
          "else": { "properties": { "usage": { "const": "user-production" } } }
        },
        {
          "if": { "properties": { "state": { "const": "active" } } },
          "then": { "not": { "required": ["invalidatedAt"] } },
          "else": { "required": ["invalidatedAt"] }
        },
        {
          "if": { "properties": { "state": { "const": "expired" } } },
          "then": { "required": ["expiresAt", "invalidatedAt"] }
        },
        {
          "if": { "properties": { "revision": { "const": 1 } } },
          "then": { "not": { "required": ["rotatedFrom"] } },
          "else": { "required": ["rotatedFrom"] }
        }
      ]
    },
    "HostConnectionResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "connectionRef", "provider", "principal", "allowedOperationIds", "scopes", "environment", "usage", "revision", "state", "resolvedAt", "credential"],
      "properties": {
        "schemaVersion": { "const": "conquistador.host-connection-resolution/v1" },
        "connectionRef": { "type": "string", "minLength": 8, "maxLength": 128 },
        "provider": { "type": "string", "minLength": 1 },
        "principal": { "$ref": "#/$defs/Principal" },
        "allowedOperationIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "scopes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "environment": { "enum": ["sandbox", "production"] },
        "usage": { "enum": ["ephemeral-test", "user-production"] },
        "revision": { "type": "integer", "minimum": 1 },
        "state": { "enum": ["active", "revoked", "expired"] },
        "resolvedAt": { "type": "string", "format": "date-time" },
        "credential": true
      }
    },
    "ConsequentialManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "proposalId", "runId", "reviewId", "candidateBuildId", "requestId", "capabilityId", "operationId", "adapterId", "adapterVersion", "connectionRef", "principal", "connectionEnvironment", "connectionRevision", "actionClass", "destinations", "platforms", "payloadDigest", "mediaDigests", "maximumUnits", "maximumCost", "dataClassification", "disclosures", "preconditionDigests", "previewDigest", "idempotencyKey", "notBefore", "expiresAt", "reversibility", "expectedOutcome", "approverPolicy", "digest"],
      "properties": {
        "schemaVersion": { "const": "conquistador.consequential-manifest/v1" },
        "id": { "type": "string" },
        "proposalId": { "type": "string" },
        "runId": { "type": "string" },
        "reviewId": { "type": "string" },
        "candidateBuildId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "requestId": { "type": "string" },
        "capabilityId": { "type": "string" },
        "operationId": { "type": "string" },
        "adapterId": { "type": "string" },
        "adapterVersion": { "type": "string" },
        "connectionRef": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "principal": { "$ref": "#/$defs/Principal" },
        "connectionEnvironment": { "enum": ["sandbox", "production"] },
        "connectionRevision": { "type": "integer", "minimum": 1 },
        "actionClass": { "const": "consequential" },
        "destinations": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "platforms": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "payloadDigest": { "$ref": "#/$defs/Sha256" },
        "mediaDigests": { "type": "array", "items": { "$ref": "#/$defs/Sha256" } },
        "scheduleAt": { "type": "string", "format": "date-time" },
        "timezone": { "type": "string" },
        "maximumUnits": { "type": "number", "minimum": 0 },
        "maximumCost": { "type": "number", "minimum": 0 },
        "dataClassification": { "enum": ["public", "internal", "confidential", "restricted"] },
        "disclosures": { "type": "array", "items": { "type": "string" } },
        "preconditionDigests": { "type": "array", "items": { "$ref": "#/$defs/Sha256" } },
        "previewDigest": { "$ref": "#/$defs/Sha256" },
        "idempotencyKey": { "type": "string", "minLength": 1 },
        "notBefore": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "reversibility": { "type": "string", "minLength": 1 },
        "expectedOutcome": { "type": "string", "minLength": 1 },
        "approverPolicy": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/Sha256" }
      }
    },
    "HumanApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "manifestDigest", "approverId", "authenticationMethod", "authenticatedHuman", "approvedAt", "expiresAt", "singleUse"],
      "properties": {
        "schemaVersion": { "const": "conquistador.human-approval/v1" },
        "id": { "type": "string" },
        "manifestDigest": { "$ref": "#/$defs/Sha256" },
        "approverId": { "type": "string", "minLength": 1 },
        "authenticationMethod": { "type": "string", "minLength": 1 },
        "authenticatedHuman": { "const": true },
        "approvedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "singleUse": { "const": true }
      }
    },
    "ToolCandidateOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "provider", "providerApiVersion"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "provider": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "providerApiVersion": { "type": "string", "minLength": 1 }
      }
    },
    "OnboardingDemand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["playbookId", "playbookVersion", "stepId", "requestedOutcome", "requestedCapability", "recordedAt", "ownerRef", "digest"],
      "properties": {
        "playbookId": { "type": "string", "pattern": "^playbook:[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "playbookVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
        "stepId": { "type": "string", "minLength": 1, "not": { "pattern": "\\*" } },
        "requestedOutcome": { "type": "string", "minLength": 1, "not": { "pattern": "\\*" } },
        "requestedCapability": { "type": "string", "minLength": 1, "not": { "pattern": "\\*" } },
        "recordedAt": { "type": "string", "format": "date-time" },
        "ownerRef": { "type": "string", "minLength": 1, "not": { "pattern": "\\*" } },
        "digest": { "$ref": "#/$defs/Sha256" }
      }
    },
    "OnboardingBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "maximumUnitsPerRun", "maximumCostPerRun"],
      "properties": {
        "mode": { "enum": ["metered", "non-metered"] },
        "maximumUnitsPerRun": { "type": ["number", "null"], "minimum": 0 },
        "maximumCostPerRun": { "type": ["number", "null"], "minimum": 0 }
      },
      "allOf": [{
        "if": { "properties": { "mode": { "const": "non-metered" } } },
        "then": { "properties": { "maximumUnitsPerRun": { "const": null }, "maximumCostPerRun": { "const": null } } },
        "else": { "properties": { "maximumUnitsPerRun": { "type": "number", "exclusiveMinimum": 0 }, "maximumCostPerRun": { "type": "number", "minimum": 0 } } }
      }]
    },
    "OnboardingOperationSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "operationId", "capabilityId", "actionClass", "providerApiVersion", "authScopes", "rateLimit", "quotaUnit", "monetaryUnit", "budget"],
      "properties": {
        "provider": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "operationId": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "capabilityId": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "actionClass": { "enum": ["observe", "metered-observe", "draft", "consequential", "prohibited"] },
        "providerApiVersion": { "type": "string", "minLength": 1, "not": { "pattern": "(?:(?:^|[._-])(?:[Ll]atest|[Dd]efault|[Aa]uto|[Cc]urrent|[Aa]ny)(?:$|[._-])|\\*)" } },
        "authScopes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "not": { "pattern": "\\*" } } },
        "rateLimit": { "type": "string", "minLength": 1, "not": { "pattern": "\\*" } },
        "quotaUnit": { "type": "string", "minLength": 1, "not": { "pattern": "\\*" } },
        "monetaryUnit": { "type": "string", "minLength": 1, "not": { "pattern": "\\*" } },
        "budget": { "$ref": "#/$defs/OnboardingBudget" }
      }
    },
    "OnboardingResearch": {
      "type": "object", "additionalProperties": false,
      "required": ["apiSources", "termsSources", "authSources", "checkedAt", "providerApiVersion", "digest"],
      "properties": {
        "apiSources": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "format": "uri", "pattern": "^https://" } },
        "termsSources": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "format": "uri", "pattern": "^https://" } },
        "authSources": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "format": "uri", "pattern": "^https://" } },
        "checkedAt": { "type": "string", "format": "date-time" },
        "providerApiVersion": { "type": "string", "minLength": 1, "not": { "pattern": "(?:(?:^|[._-])(?:[Ll]atest|[Dd]efault|[Aa]uto|[Cc]urrent|[Aa]ny)(?:$|[._-])|\\*)" } },
        "digest": { "$ref": "#/$defs/Sha256" }
      }
    },
    "OnboardingFixtureProof": {
      "type": "object", "additionalProperties": false,
      "required": ["fixtureId", "digest", "adapterVersion", "providerVersion", "checkedAt"],
      "properties": {
        "fixtureId": { "type": "string", "minLength": 1, "not": { "pattern": "\\*" } }, "digest": { "$ref": "#/$defs/Sha256" },
        "adapterVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
        "providerVersion": { "type": "string", "minLength": 1, "not": { "pattern": "(?:(?:^|[._-])(?:[Ll]atest|[Dd]efault|[Aa]uto|[Cc]urrent|[Aa]ny)(?:$|[._-])|\\*)" } }, "checkedAt": { "type": "string", "format": "date-time" }
      }
    },
    "OnboardingLiveProof": {
      "type": "object", "additionalProperties": false,
      "required": ["candidateBuildId", "adapterId", "adapterVersion", "receipt", "supervisorId", "authenticatedHuman", "authenticationMethod", "acceptedAt", "humanAcceptanceId"],
      "properties": {
        "candidateBuildId": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "adapterId": { "type": "string", "minLength": 1, "not": { "pattern": "\\*" } },
        "adapterVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" }, "receipt": { "$ref": "#/$defs/Receipt" },
        "supervisorId": { "type": "string", "minLength": 1, "not": { "pattern": "\\*" } },
        "authenticatedHuman": { "const": true }, "authenticationMethod": { "type": "string", "minLength": 1, "not": { "pattern": "\\*" } },
        "acceptedAt": { "type": "string", "format": "date-time" }, "humanAcceptanceId": { "type": "string", "minLength": 1, "not": { "pattern": "\\*" } }
      }
    },
    "OnboardingSupportProof": {
      "type": "object", "additionalProperties": false,
      "required": ["releaseMatrixId", "digest", "platform", "architecture", "checkedAt", "acceptedBy", "authenticatedHuman", "authenticationMethod", "acceptedAt", "humanAcceptanceId"],
      "properties": {
        "releaseMatrixId": { "type": "string", "minLength": 1, "not": { "pattern": "\\*" } }, "digest": { "$ref": "#/$defs/Sha256" },
        "platform": { "type": "string", "minLength": 1, "not": { "pattern": "(?:^unbound$|\\*)" } }, "architecture": { "type": "string", "minLength": 1, "not": { "pattern": "(?:^unbound$|\\*)" } },
        "checkedAt": { "type": "string", "format": "date-time" }, "acceptedBy": { "type": "string", "minLength": 1, "not": { "pattern": "\\*" } },
        "authenticatedHuman": { "const": true }, "authenticationMethod": { "type": "string", "minLength": 1, "not": { "pattern": "\\*" } },
        "acceptedAt": { "type": "string", "format": "date-time" }, "humanAcceptanceId": { "type": "string", "minLength": 1, "not": { "pattern": "\\*" } }
      }
    },
    "OnboardingFailurePosture": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "reasonCodes", "fallback", "retry"],
      "properties": {
        "state": { "enum": ["none", "blocked", "degraded"] }, "reasonCodes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "not": { "pattern": "\\*" } } },
        "fallback": { "enum": ["human-action-manifest", "fail-closed"] },
        "retry": {
          "type": "object", "additionalProperties": false, "required": ["strategy", "maximumAttempts", "backoff"],
          "properties": { "strategy": { "enum": ["none", "bounded"] }, "maximumAttempts": { "type": "integer", "minimum": 0, "maximum": 5 }, "backoff": { "enum": ["none", "fixed", "exponential"] } },
          "allOf": [
            { "if": { "properties": { "strategy": { "const": "none" } } }, "then": { "properties": { "maximumAttempts": { "const": 0 }, "backoff": { "const": "none" } } } },
            { "if": { "properties": { "strategy": { "const": "bounded" } } }, "then": { "properties": { "maximumAttempts": { "type": "integer", "minimum": 1, "maximum": 5 }, "backoff": { "enum": ["fixed", "exponential"] } } } }
          ]
        },
        "evidence": { "type": "string", "minLength": 1, "not": { "pattern": "\\*" } }, "assertedAt": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        { "if": { "properties": { "state": { "const": "none" } } }, "then": { "properties": { "reasonCodes": { "maxItems": 0 } }, "not": { "anyOf": [{ "required": ["evidence"] }, { "required": ["assertedAt"] }] } } },
        { "if": { "properties": { "state": { "enum": ["blocked", "degraded"] } } }, "then": { "required": ["evidence", "assertedAt"], "properties": { "reasonCodes": { "minItems": 1 } } } }
      ]
    },
    "ProviderOnboardingRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "id", "maturity", "supportCellId", "demand", "operation", "supportOwner", "nextProofOwner", "failure"],
      "properties": {
        "schemaVersion": { "const": "conquistador.provider-onboarding/v1" }, "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.:-][a-z0-9]+)*$" },
        "maturity": { "enum": ["unknown", "cataloged", "researched", "fixture-verified", "live-verified", "supported"] },
        "supportCellId": { "type": "string", "minLength": 1, "not": { "pattern": "\\*" } }, "demand": { "$ref": "#/$defs/OnboardingDemand" }, "operation": { "$ref": "#/$defs/OnboardingOperationSnapshot" },
        "supportOwner": { "type": "string", "minLength": 1, "not": { "pattern": "\\*" } }, "nextProofOwner": { "type": "string", "minLength": 1, "not": { "pattern": "\\*" } }, "failure": { "$ref": "#/$defs/OnboardingFailurePosture" },
        "research": { "$ref": "#/$defs/OnboardingResearch" }, "fixtureProof": { "$ref": "#/$defs/OnboardingFixtureProof" },
        "liveProof": { "$ref": "#/$defs/OnboardingLiveProof" }, "supportProof": { "$ref": "#/$defs/OnboardingSupportProof" }
      },
      "allOf": [
        { "if": { "properties": { "maturity": { "enum": ["unknown", "cataloged"] } } }, "then": { "not": { "anyOf": [{ "required": ["research"] }, { "required": ["fixtureProof"] }, { "required": ["liveProof"] }, { "required": ["supportProof"] }] } } },
        { "if": { "properties": { "maturity": { "const": "researched" } } }, "then": { "required": ["research"], "not": { "anyOf": [{ "required": ["fixtureProof"] }, { "required": ["liveProof"] }, { "required": ["supportProof"] }] } } },
        { "if": { "properties": { "maturity": { "const": "fixture-verified" } } }, "then": { "required": ["research", "fixtureProof"], "not": { "anyOf": [{ "required": ["liveProof"] }, { "required": ["supportProof"] }] } } },
        { "if": { "properties": { "maturity": { "const": "live-verified" } } }, "then": { "required": ["research", "fixtureProof", "liveProof"], "not": { "required": ["supportProof"] } } },
        { "if": { "properties": { "maturity": { "const": "supported" } } }, "then": { "required": ["research", "fixtureProof", "liveProof", "supportProof"] } }
      ]
    },
    "ToolCandidateBuild": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "productVersion", "sourceCommit", "sourceTree", "catalogDigest", "moduleSourceDigest", "fixtureDigest", "adapterVersion", "operations", "candidateBuildId"],
      "properties": {
        "schemaVersion": { "const": "conquistador.tool-candidate/v1" },
        "productVersion": { "const": "1.0.0" },
        "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "sourceTree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "catalogDigest": { "$ref": "#/$defs/Sha256" },
        "moduleSourceDigest": { "$ref": "#/$defs/Sha256" },
        "fixtureDigest": { "$ref": "#/$defs/Sha256" },
        "adapterVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
        "operations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/ToolCandidateOperation" } },
        "candidateBuildId": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "Receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "candidateBuildId", "requestId", "capabilityId", "operationId", "provider", "actionClass", "requestDigest", "destinationDigests", "startedAt", "finishedAt", "status", "unitsUsed", "costUsed", "sourceUrls", "retryCount", "redactionApplied", "terminalRecord", "receiptDigest"],
      "properties": {
        "schemaVersion": { "const": "conquistador.receipt/v1" },
        "id": { "type": "string" },
        "candidateBuildId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "requestId": { "type": "string" },
        "proposalId": { "type": "string" },
        "manifestDigest": { "$ref": "#/$defs/Sha256" },
        "approvalId": { "type": "string" },
        "runId": { "type": "string" },
        "reviewId": { "type": "string" },
        "capabilityId": { "type": "string" },
        "operationId": { "type": "string" },
        "adapterId": { "type": "string" },
        "adapterVersion": { "type": "string" },
        "provider": { "type": "string" },
        "connectionRef": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "connectionRevision": { "type": "integer", "minimum": 1 },
        "connectionEnvironment": { "enum": ["sandbox", "production"] },
        "connectionPrincipal": { "$ref": "#/$defs/Principal" },
        "actionClass": { "enum": ["observe", "metered-observe", "draft", "consequential", "prohibited"] },
        "requestDigest": { "$ref": "#/$defs/Sha256" },
        "payloadDigest": { "$ref": "#/$defs/Sha256" },
        "destinationDigests": { "type": "array", "items": { "$ref": "#/$defs/Sha256" } },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" },
        "status": { "enum": ["succeeded", "partial", "failed", "pending", "unknown", "rejected", "expired", "blocked"] },
        "providerStatus": { "enum": ["succeeded", "partial", "pending", "unknown"] },
        "providerRequestId": { "type": "string" },
        "providerCorrelationId": { "type": "string" },
        "providerResourceId": { "type": "string" },
        "unitsUsed": { "type": "number", "minimum": 0 },
        "costUsed": { "type": "number", "minimum": 0 },
        "pagination": { "type": "object" },
        "sourceUrls": { "type": "array", "items": { "type": "string" } },
        "safeResponseDigest": { "$ref": "#/$defs/Sha256" },
        "safeExcerpt": { "type": "string" },
        "error": { "$ref": "#/$defs/CapabilityError" },
        "retryCount": { "type": "integer", "minimum": 0 },
        "idempotencyKey": { "type": "string" },
        "reversalGuidance": { "type": "string" },
        "redactionApplied": { "const": true },
        "terminalRecord": { "const": true },
        "receiptDigest": { "$ref": "#/$defs/Sha256" }
      },
      "allOf": [
        {
          "if": { "anyOf": [
            { "required": ["connectionRef"] },
            { "required": ["connectionRevision"] },
            { "required": ["connectionEnvironment"] },
            { "required": ["connectionPrincipal"] }
          ] },
          "then": { "required": ["connectionRef", "connectionRevision", "connectionEnvironment", "connectionPrincipal"] }
        }
      ]
    }
  }
}
