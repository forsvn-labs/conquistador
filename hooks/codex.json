{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/conquistador-hook.mjs\" codex prompt",
            "timeout": 15,
            "additionalContextLimit": 0
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/conquistador-hook.mjs\" codex stop",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
