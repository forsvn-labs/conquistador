{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/conquistador-hook.mjs\" cursor start",
        "timeout": 15
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/conquistador-hook.mjs\" cursor prompt",
        "timeout": 15
      }
    ],
    "postToolUse": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/check-hook.mjs\" cursor edit",
        "matcher": "Write",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/conquistador-hook.mjs\" cursor stop",
        "timeout": 15
      }
    ]
  }
}
