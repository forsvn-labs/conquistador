{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conquistador.execution-receipt/v1",
  "title": "Conquistador execution receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "outcome",
    "capabilities",
    "specialists",
    "mode",
    "independentReview",
    "integratedDigest",
    "evidence",
    "gaps",
    "externalActions",
    "humanAccepted"
  ],
  "properties": {
    "schemaVersion": {
      "const": "conquistador.execution-receipt/v1"
    },
    "runId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "outcome": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "capabilities": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        }
      }
    },
    "specialists": {
      "type": "array",
      "maxItems": 12,
      "description": "Plan assignments, then observed integration, initial review, correction and final-review executions. Skipped assignments have status not-run and no execution ID. Reviews bind their own reviewedDigest. Total rows remain within the twelve-dispatch plan bound.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assignmentId",
          "label",
          "executionId",
          "status"
        ],
        "properties": {
          "assignmentId": {
            "type": "string",
            "pattern": "^(?:[a-z][a-z0-9-]{0,63}|operator:(?:correct|final-review))$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "enum": [
              "Ads",
              "Copy",
              "Direct-response landing",
              "SaaS landing",
              "Data diagnosis",
              "Campaign data",
              "Creative assets",
              "Outcome",
              "Integration",
              "Correction",
              "Review",
              "Final review"
            ]
          },
          "executionId": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,79}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "revise",
              "blocked",
              "not-run"
            ]
          },
          "reviewedDigest": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    },
    "mode": {
      "type": "string",
      "enum": [
        "isolated-workers",
        "sequential-in-context"
      ]
    },
    "independentReview": {
      "type": "boolean"
    },
    "integratedDigest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "evidence": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "gaps": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "externalActions": {
      "type": "array",
      "maxItems": 0
    },
    "humanAccepted": {
      "const": false
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "revise",
        "blocked"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "sequential-in-context"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "independentReview": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "independentReview": {
            "const": true
          }
        },
        "required": [
          "independentReview"
        ]
      },
      "then": {
        "properties": {
          "integratedDigest": {
            "type": "string"
          },
          "specialists": {
            "contains": {
              "type": "object",
              "properties": {
                "assignmentId": {
                  "enum": [
                    "review",
                    "operator:final-review"
                  ]
                },
                "status": {
                  "enum": [
                    "draft",
                    "revise",
                    "blocked"
                  ]
                }
              },
              "required": [
                "assignmentId",
                "status"
              ]
            },
            "type": "array"
          }
        }
      }
    }
  ]
}
