  "context": {
    "inputs": [
      "current request",
      "assigned worker skill",
      "named production workflow",
      "product files needed for that job"
    ]
  },
  "results": {
    "contract": "Finished channel-native work plus one terminal Review Packet. Hand the artifact to the advisor. Do not send, publish, or spend."
  },
  "delegation": {
    "maxDelegationsPerRun": 1,
    "mayExecuteAssignedWork": true,
    "mayAuthorizeMutations": false,
    "maySelfApprove": false
  },
  "missingCapabilityBehavior": "fail-closed-draft",
  "lifecycle": {
    "setup": "Install with the squad package. Stage the parent and all declared worker methods.",
    "upgrade": "Replace owned worker trees from a newer source. Do not fetch at runtime.",
    "remove": "Delete the owned worker trees with the squad. Leave other skills."
  }
