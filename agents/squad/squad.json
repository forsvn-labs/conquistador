{
  "schemaVersion": "conquistador.squad-package/v1",
  "id": "squad:advisor-worker",
  "displayName": "Advisor/worker squad",
  "productName": "conquistador",
  "pluginVersion": "0.1.0",
  "installClass": "candidate-only",
  "publicListing": false,
  "cleanHostProof": false,
  "zeroRuntime": true,
  "members": ["agent:advisor", "agent:worker"],
  "fallback": "sequential-in-context",
  "fallbackIsIndependentContext": false,
  "delegation": {
    "maxHandoffsPerRun": 1,
    "order": ["worker", "advisor"],
    "advisorCannotExecuteWorkerSkills": true,
    "workerCannotSelfApprove": true,
    "contextBudget": "assigned-skill-plus-named-workflow-plus-current-artifact"
  },
  "notThisDoor": [
    "single Conquistador agent",
    "complete coding-agent plugin",
    "per-skill agents/ files inside outcome skills",
    "decision-panel as a squad",
    "generic bot import",
    "Eve agent",
    "official xAI Grok Bot"
  ],
  "missingCapabilityBehavior": "fail-closed-draft",
  "lifecycle": {
    "setup": "Stage squad.json, sequential-fallback.md, both member contracts, parent conquistador, and each member's declared skills.",
    "upgrade": "Replace owned squad files and owned skill trees from a newer source. Do not fetch at runtime.",
    "remove": "Delete the owned squad directory. Leave other skills and user artifacts."
  }
}
