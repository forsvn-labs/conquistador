{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forsvn.com/schemas/conquistador/capability-router-v1.json",
  "title": "Conquistador Capability Router contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "version",
    "productVersion",
    "activationRequiredByPortablePlugin",
    "loadsAtPluginRuntime",
    "abstention",
    "routes"
  ],
  "properties": {
    "schemaVersion": { "const": "conquistador.capability-router/v1" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
    "productVersion": { "const": "1.0.0" },
    "activationRequiredByPortablePlugin": { "const": false },
    "loadsAtPluginRuntime": { "const": false },
    "abstention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["onZeroMatches", "onMultipleMatches", "onEmptyIntent", "neverGuess"],
      "properties": {
        "onZeroMatches": { "const": "abstain" },
        "onMultipleMatches": { "const": "abstain" },
        "onEmptyIntent": { "const": "abstain" },
        "neverGuess": { "const": true }
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Route" }
    }
  },
  "$defs": {
    "Route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "phrases"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "enum": ["playbook", "skill"] },
            "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" }
          }
        },
        "phrases": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
