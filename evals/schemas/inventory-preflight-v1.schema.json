{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forsvn.com/schemas/conquistador/eval-inventory-preflight-v1.json",
  "title": "Closed EXTS-156 offline inventory and candidate execution plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "generatedAt", "status", "releaseState", "candidate", "sourceAuthorities", "cases", "executionPlan", "counts", "authority"],
  "$defs": {
    "Sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "SourceBinding": { "type": "object", "additionalProperties": false, "required": ["path", "digest"], "properties": { "path": { "type": "string", "minLength": 1 }, "digest": { "$ref": "#/$defs/Sha256" } } },
    "CasePartition": { "enum": ["outcome-core", "outcome-deep", "parent-workflow", "historical-parity", "grader-calibration"] },
    "CaseClass": { "enum": ["normal", "boundary", "sparse-evidence", "cross-context", "parent", "workflow", "parity", "calibration"] },
    "CaseSource": { "type": "object", "additionalProperties": false, "required": ["path", "version", "digest"], "properties": { "path": { "type": "string", "minLength": 1 }, "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }, "digest": { "$ref": "#/$defs/Sha256" } } },
    "InventoryCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "partition", "class", "subjectId", "prompt", "assertions", "source", "repetitionCount"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "partition": { "$ref": "#/$defs/CasePartition" },
        "class": { "$ref": "#/$defs/CaseClass" },
        "subjectId": { "type": "string", "minLength": 1 },
        "prompt": { "type": "string", "minLength": 1 },
        "assertions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "source": { "$ref": "#/$defs/CaseSource" },
        "repetitionCount": { "enum": [1, 3] },
        "obligation": { "type": "string", "minLength": 1 },
        "compositionInputOnly": { "const": true },
        "executablePlaybook": { "const": false },
        "claimedExecuted": { "const": false },
        "directOnly": { "const": true }
      }
    },
    "PlannedExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "caseId", "repetition", "candidateBuildId", "providerCellId", "immutableBindings", "status", "authority"],
      "properties": {
        "id": { "type": "string", "pattern": "^plan:.+:r[123]$" },
        "caseId": { "type": "string", "minLength": 1 },
        "repetition": { "enum": [1, 2, 3] },
        "candidateBuildId": { "type": "null" },
        "providerCellId": { "type": "null" },
        "immutableBindings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inputDigest", "outputDigest", "traceDigest", "reviewPacketDigest"],
          "properties": { "inputDigest": { "$ref": "#/$defs/Sha256" }, "outputDigest": { "type": "null" }, "traceDigest": { "type": "null" }, "reviewPacketDigest": { "type": "null" } }
        },
        "status": { "const": "planned-unbound" },
        "authority": { "const": "none" }
      }
    },
    "AaPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executionsPerBoundProviderModelCell", "classes", "executions"],
      "properties": {
        "executionsPerBoundProviderModelCell": { "const": 12 },
        "classes": { "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": { "enum": ["normal", "boundary", "deep", "parent"] } },
        "executions": { "type": "array", "maxItems": 0 }
      }
    },
    "BindingBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exactCandidateBuildRequired", "exactProviderModelCellRequired", "floatingIdentitiesDenied", "evidenceBeforeBinding", "immutableInputOutputTraceReviewPacketRequired"],
      "properties": {
        "exactCandidateBuildRequired": { "const": true },
        "exactProviderModelCellRequired": { "const": true },
        "floatingIdentitiesDenied": { "const": true },
        "evidenceBeforeBinding": { "const": false },
        "immutableInputOutputTraceReviewPacketRequired": { "const": true }
      }
    }
  },
  "properties": {
    "schemaVersion": { "const": "conquistador.eval-inventory-preflight/v1" },
    "id": { "const": "local:exts-156:inventory:v1" },
    "generatedAt": { "const": "2026-08-21T00:00:00.000Z" },
    "status": { "const": "inventory-complete-candidate-unbound" },
    "releaseState": { "const": "NO-GO" },
    "candidate": { "const": "UNBOUND" },
    "sourceAuthorities": {
      "type": "object", "additionalProperties": false,
      "required": ["reviewContract", "localImplementation", "benchmarkMatrix", "seedRegistry"],
      "properties": { "reviewContract": { "$ref": "#/$defs/SourceBinding" }, "localImplementation": { "$ref": "#/$defs/SourceBinding" }, "benchmarkMatrix": { "$ref": "#/$defs/SourceBinding" }, "seedRegistry": { "$ref": "#/$defs/SourceBinding" } }
    },
    "cases": { "type": "array", "minItems": 237, "maxItems": 237, "items": { "$ref": "#/$defs/InventoryCase" } },
    "executionPlan": {
      "type": "object", "additionalProperties": false,
      "required": ["repetitionsPerCandidateCase", "casePassMinimum", "brokenRunMaximumPerCase", "unresolvedTerminalRunsMaximum", "varianceRequired", "brokenRunsCountAsPass", "plannedExecutions", "aaPolicy", "bindingBoundary"],
      "properties": {
        "repetitionsPerCandidateCase": { "const": 3 },
        "casePassMinimum": { "const": 2 },
        "brokenRunMaximumPerCase": { "const": 1 },
        "unresolvedTerminalRunsMaximum": { "const": 0 },
        "varianceRequired": { "const": true },
        "brokenRunsCountAsPass": { "const": false },
        "plannedExecutions": { "type": "array", "minItems": 567, "maxItems": 567, "items": { "$ref": "#/$defs/PlannedExecution" } },
        "aaPolicy": { "$ref": "#/$defs/AaPolicy" },
        "bindingBoundary": { "$ref": "#/$defs/BindingBoundary" }
      }
    },
    "counts": { "type": "object", "additionalProperties": false, "required": ["candidateExecutions", "providerModelCellsBound", "aaExecutions", "humanVerdicts"], "properties": { "candidateExecutions": { "const": 0 }, "providerModelCellsBound": { "const": 0 }, "aaExecutions": { "const": 0 }, "humanVerdicts": { "const": 0 } } },
    "authority": { "type": "object", "additionalProperties": false, "required": ["modelOutputCanCreateHumanVerdict", "modelOutputCanAuthorizeAction", "modelOutputCanCreateReleaseClaim", "modelOutputCanMutateBenchmark", "modelOutputCanPublish", "autoresearchScopeExpansion", "supportPromotion"], "properties": { "modelOutputCanCreateHumanVerdict": { "const": false }, "modelOutputCanAuthorizeAction": { "const": false }, "modelOutputCanCreateReleaseClaim": { "const": false }, "modelOutputCanMutateBenchmark": { "const": false }, "modelOutputCanPublish": { "const": false }, "autoresearchScopeExpansion": { "const": false }, "supportPromotion": { "const": false } } }
  }
}
