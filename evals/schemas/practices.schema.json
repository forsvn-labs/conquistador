{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forsvn.com/schemas/conquistador/practices-1.0.0.schema.json",
  "title": "Conquistador practice registry",
  "description": "Maps every method to one practice, with its judge and latest blind-test status. Public names and statuses only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "practices", "nonMethods"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "conquistador.practices/v1" },
    "practices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "judge", "status", "members"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "judge": {
            "description": "human: the owner judges taste work blind. pending-calibration: decision work, judge not yet calibrated.",
            "enum": ["human", "pending-calibration"]
          },
          "status": { "enum": ["untested", "baseline", "passed", "failed", "pass-through"] },
          "commit": { "description": "Commit the judged method drafts were written at.", "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
          "date": { "description": "Date of the blind test (YYYY-MM-DD).", "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$" },
          "pr": { "description": "Public pull request that carries the change.", "type": "integer", "minimum": 1 },
          "note": { "type": "string", "maxLength": 200 },
          "members": {
            "type": "array",
            "items": { "type": "string", "pattern": "^(commands|plays|channels|formats|specialists)/[a-z0-9][a-z0-9-]*$" },
            "uniqueItems": true
          }
        }
      }
    },
    "nonMethods": {
      "description": "Files in a method folder that are not methods themselves.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["member", "reason"],
        "properties": {
          "member": { "type": "string", "pattern": "^(commands|plays|channels|formats|specialists)/[a-z0-9][a-z0-9-]*$" },
          "reason": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    }
  }
}
