#!/usr/bin/expect -f
# Drive `conquistador tour` in a real terminal: pick "Growth inside the product", take its first
# example, and confirm the tour shows specialists, playbooks, and a paste-ready prompt.
#   expect tools/e2e/tour.exp > dist/e2e/tour/transcript.txt
set timeout 20
set root [file dirname [file dirname [file dirname [file normalize [info script]]]]]
spawn env TERM=xterm-256color node $root/runtime/bin/conquistador.js tour
# A spawned pseudo-terminal starts with zero columns; give it a normal size.
stty rows 50 columns 120 < $spawn_out(slave,name)
expect "What are you working on?"
# Areas are listed in tools/tour.mjs order; "Growth inside the product" is the seventh.
for {set i 0} {$i < 6} {incr i} { send "\033\[B"; sleep 0.1 }
send "\r"
expect "Pick an example"
send "\r"
# Collect everything to the end, then check the whole transcript.
set all ""
expect {
  -re {.+} { append all $expect_out(buffer); exp_continue }
  eof {}
}
foreach text {"How Conquistador will work" "Specialists: Conversion" "Playbooks it reads first" "Paste this into your agent"} {
  if {[string first $text $all] < 0} { puts "\nE2E FAIL: missing \"$text\""; exit 1 }
}
puts "\nE2E PASS: tour reached specialists, playbooks, and a paste-ready prompt"
