#!/usr/bin/expect -f
# The installer with real agents in an isolated home. No model is called and no agent opens.
#   1. `conquistador --surface=agents` opens the full-screen installer with the detected agents
#      chosen, installs into real Claude Code and Codex, checks the installs, and ends by saying
#      what to type in each agent (/conquistador init, no GROWTH.md yet). No agent opens (T13).
#   2. With GROWTH.md, bare `conquistador` shows the home screen, not the installer (T10).
#   2b. `conquistador --scope=project --surface=agents` in a second project: one skill copy per folder.
#   3. `conquistador "TASK"` prints the task context and opens no agent, in a terminal or not (T14).
#   5b. `conquistador remove grok` keeps Grok out of later bare runs; `conquistador remove` cleans up.
#   expect tools/e2e/real-agents.exp   → dist/e2e/real-agents/transcript.txt and report.json
set timeout 60
# Full-screen frames are long; keep everything since the last match, not only the last 2000 bytes.
match_max -d 1000000
set root [file dirname [file dirname [file dirname [file normalize [info script]]]]]
set out $root/dist/e2e/real-agents
file mkdir $out
set home [exec mktemp -d -t conquistador-e2e-real-agents.XXXXXX]
foreach {name value} [list HOME $home CLAUDE_CONFIG_DIR $home/.claude CODEX_HOME $home/.codex CONQUISTADOR_HOME $home/.conquistador CURSOR_HOME $home/.cursor TERM xterm-256color] { set env($name) $value }
foreach name {CONQUISTADOR_PLAYBOOKS CLAUDECODE CLAUDE_CODE_CHILD_SESSION CLAUDE_CODE_ENTRYPOINT} { if {[info exists env($name)]} { unset env($name) } }
# A user who has used Claude Code before: onboarding done. The folder is not trusted yet.
file mkdir $home/.claude
set fh [open $home/.claude/.claude.json w]; puts $fh {{"hasCompletedOnboarding": true, "theme": "dark"}}; close $fh
# A small product repository.
set project $home/acme
file mkdir $project
set fh [open $project/README.md w]; puts $fh "# Acme Invoices\n\nInvoicing for freelance designers. Free plan and a \$12 Pro plan."; close $fh
exec git -C $project init -q
# CONQUISTADOR_E2E_CLI runs the flow against an installed package instead of the checkout.
if {[info exists env(CONQUISTADOR_E2E_CLI)]} { set cli [list $env(CONQUISTADOR_E2E_CLI)] } else { set cli [list node $root/runtime/bin/conquistador.js] }

set transcript ""
set checks {}
# Claude Code draws spaces as cursor-forward moves; turn them back into spaces first.
proc plain {text} { regsub -all {\x1b\[[0-9]*C} $text " " text; regsub -all {\x1b\[[0-9;?]*[A-Za-z]} $text "" text; regsub -all {\x1b\][^\x07]*\x07} $text "" text; return $text }
proc record {name ok detail} {
  global checks
  lappend checks [list $name $ok $detail]
  puts "\n[expr {$ok ? {CHECK PASS} : {CHECK FAIL}}]: $name $detail"
}
proc fail {why} { global out transcript; set fh [open $out/transcript.txt w]; puts $fh [plain $transcript]; close $fh; puts "\nE2E FAIL: $why"; exit 1 }
proc step {pattern} {
  global transcript
  expect {
    -re $pattern { append transcript $expect_out(buffer) }
    timeout { expect -timeout 1 -re {.+} { append transcript $expect_out(buffer) }; fail "timed out waiting for $pattern" }
    eof { append transcript $expect_out(buffer); fail "exited before $pattern" }
  }
}
proc finish {} {
  global transcript
  expect {
    eof { append transcript $expect_out(buffer) }
    timeout { fail "process did not exit" }
  }
  lassign [wait] pid spawnid os code
  return $code
}
# Terminal redraws can drop or move spaces, so compare without whitespace.
proc squash {text} { regsub -all {\s+} $text "" text; return $text }
proc has {text} { global transcript; return [expr {[string first [squash $text] [squash [plain $transcript]]] >= 0}] }
# Read what the screen drew after the last match.
proc drain {} { global transcript; expect -timeout 2 -re {.+} { append transcript $expect_out(buffer); exp_continue } timeout {} eof {} }
# True when an agent process runs with this text in its arguments (a launch would show up here).
proc launched {text} {
  foreach line [split [exec ps -axo args] "\n"] { if {[regexp {(claude|codex)} $line] && [string first $text $line] >= 0 && ![regexp {conquistador\.js|expect} $line]} { return 1 } }
  return 0
}

# --- 1. First run: keep the detected agents, global scope ------------------------------------
cd $project
set transcript ""
eval spawn $cli --surface=agents
stty rows 50 columns 140 < $spawn_out(slave,name)
step {Which agents\?}
step {Claude Code}
set altScreen [format "%c%s" 27 {[?1049h}]
record "first run opens the full-screen installer" [expr {[string first $altScreen $transcript] >= 0}] ""
record "first run shows the detected agents" [expr {[has "Which agents"] && [has "Claude Code"]}] ""
send "\r"
step {Choose options}
send "\r"
step {Review the changes}
send "\r"
# Every detected plugin manager runs now; that can take a few minutes.
set timeout 600
step {Conquistador is ready|Installed with problems}
set timeout 60
drain
record "first run installs every kept agent" [expr {[has "✓ Claude Code"] || [has "Claude Code /conquistador init"]}] ""
record "first run checks the installs" [has "checks passed"] ""
record "the last screen says /conquistador init (no GROWTH.md yet)" [has "/conquistador init"] ""
record "no agent opened" [expr {![launched "/conquistador init"]}] ""
send "\r"
step {Summary}
set code1 [finish]
record "first run exits 0 and leaves the summary" [expr {$code1 == 0 && [has "conquistador doctor"]}] "exit $code1"
record "Claude Code lists the plugin" [expr {[string first "conquistador@conquistador" [exec -ignorestderr claude plugin list]] >= 0}] ""
set run1 $transcript

# --- 2. Second run: GROWTH.md exists; the home screen, no installer, no task picker ---------
set fh [open $project/GROWTH.md w]; puts $fh "# Growth\n\n## Goals and metrics\n\nReach 200 paying designers."; close $fh
set transcript ""
eval spawn $cli
stty rows 50 columns 140 < $spawn_out(slave,name)
step {Conquistador is installed}
drain
record "second run shows the installs, not the installer" [expr {![has "Which agents"] && ![has "Review the changes"]}] ""
record "second run never asks for a task" [expr {![has "What should we work on"]}] ""
record "second run says what to type in the agent" [has "In your agent, type: /conquistador"] ""
send "q"
set code2 [finish]
record "q on the home screen exits 0" [expr {$code2 == 0}] "exit $code2"
set run2 $transcript

# --- 2b. Project scope in a second project ----------------------------------------------------
set project2 $home/studio
file mkdir $project2
set fh [open $project2/README.md w]; puts $fh "# Studio\n\nA booking tool for photo studios."; close $fh
exec git -C $project2 init -q
cd $project2
set transcript ""
eval spawn $cli --scope=project --surface=agents
stty rows 50 columns 140 < $spawn_out(slave,name)
step {Which agents\?}
send "\r"
step {Review the changes}
record "--scope skips the options" [expr {![has "Choose options"]}] ""
send "\r"
step {Conquistador is ready|Installed with problems}
drain
send "\r"
finish
record "project scope copies one skill into .claude/skills and .agents/skills" [expr {[file exists $project2/.claude/skills/conquistador/SKILL.md] && [file exists $project2/.agents/skills/conquistador/SKILL.md]}] ""
record "the second project says /conquistador init" [has "/conquistador init"] ""
set run2b $transcript
cd $project

# --- 3. A task prints context; nothing opens -----------------------------------------------------
set transcript ""
eval spawn $cli {"Write a cold email sequence to HR directors"}
stty rows 50 columns 140 < $spawn_out(slave,name)
step {/conquistador Write a cold email sequence to HR directors}
set code3 [finish]
record "a task in a terminal prints the context and exits 0" [expr {$code3 == 0 && [has ".md"]}] "exit $code3"
record "a task opens no agent" [expr {![launched "Write a cold email sequence"]}] ""
set run3 $transcript
set piped [exec sh -c "cd '$project' && node '$root/runtime/bin/conquistador.js' 'Plan a Product Hunt launch' < /dev/null | cat"]
record "without a terminal a task prints the playbooks and the slash command" [expr {[string first "/conquistador Plan a Product Hunt launch" $piped] >= 0}] ""

# --- 5b. An agent removed by name stays removed on a bare run ------------------------------
exec {*}$cli remove grok
cd $project
set transcript ""
eval spawn $cli
stty rows 50 columns 140 < $spawn_out(slave,name)
step {Conquistador is installed}
record "bare run does not reinstall an agent removed by name" [expr {![has "Review the changes"] && ![has "Installing"]}] ""
send "\033"
finish
set run5b $transcript

# --- 6. Remove ---------------------------------------------------------------------------------
set removal [exec {*}$cli remove]
record "remove cleans up the plugin copy" [expr {![file exists $home/.conquistador/plugin]}] ""
cd $project2
append removal "\n" [exec {*}$cli remove --scope=project]
record "remove --scope=project deletes the project copies" [expr {![file exists $project2/.claude/skills/conquistador] && ![file exists $project2/.agents/skills/conquistador]}] ""

# --- Artifacts ---------------------------------------------------------------------------------
set fh [open $out/transcript.txt w]
puts $fh "## Run 1: first run\n[plain $run1]\n\n## Run 2: second run\n[plain $run2]\n\n## Run 2b: project scope\n[plain $run2b]\n\n## Run 3: a task\n[plain $run3]\n\n## Run 3b: a task without a terminal\n$piped\n\n## Run 5b: after remove grok\n[plain $run5b]\n\n## Run 6: remove\n$removal"
close $fh
set failed 0
set rows {}
foreach c $checks {
  lassign $c name ok detail
  if {!$ok} { incr failed }
  lappend rows "    {\"check\": \"$name\", \"pass\": [expr {$ok ? {true} : {false}}]}"
}
# The first line of `--version`. Codex also writes warnings to stderr, which exec treats as an error.
proc agentVersion {command} {
  if {[catch {exec -ignorestderr $command --version} text]} { return unknown }
  return [lindex [split [string trim $text] "\n"] 0]
}
set fh [open $out/report.json w]
puts $fh "{\n  \"test\": \"real-agents\",\n  \"claude\": \"[agentVersion claude]\",\n  \"codex\": \"[agentVersion codex]\",\n  \"passed\": [expr {[llength $checks] - $failed}],\n  \"failed\": $failed,\n  \"checks\": \[\n[join $rows ",\n"]\n  \]\n}"
close $fh
exec rm -rf $home
if {$failed} { puts "\nE2E FAIL: $failed of [llength $checks] checks failed. See $out/transcript.txt"; exit 1 }
puts "\nE2E PASS: [llength $checks] of [llength $checks] checks. Artifacts in $out"
